# OpenDB Configuration Environment Variables

# Application
APP_NAME=OpenDB
APP_ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=opendb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://admin:password123@localhost:5433/opendb

# Storage
RAW_STORAGE_DIR=./data

# Crawler
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=20
CRAWL_CONCURRENCY=5
RESOURCE_MAX_FILE_SIZE_MB=10

# LLM Extraction (Optional)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
