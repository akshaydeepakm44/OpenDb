# ==============================================================================
# OpenDB — Canonical Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ─── 1. APPLICATION ENVIRONMENT MODE ──────────────────────────────────────────
# Options: 'development' (local workstation) or 'production' (server with Docker)
APP_ENV=production
OPENDB_ENV=production
LOG_LEVEL=INFO

# ─── 2. POSTGRESQL & VECTOR STORE ─────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=opendb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:change_me_in_production@postgres:5432/opendb

# ─── 3. MINIO OBJECT STORAGE (S3-COMPATIBLE) ──────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_SECURE=false
STORAGE_BACKEND=minio

# ─── 4. REDIS & CELERY MESSAGE BROKER ─────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_secret
REDIS_URL=redis://:change_me_redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:change_me_redis_secret@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change_me_redis_secret@redis:6379/0

# ─── 5. SEARXNG META-SEARCH SERVICE ───────────────────────────────────────────
SEARXNG_URL=http://searxng:8080
SEARXNG_BASE_URL=http://localhost:9090

# ─── 6. LLM INFERENCE (QWEN GPU / OLLAMA / OPENAI) ────────────────────────────
OPENAI_API_KEY=your_openai_or_qwen_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
OPENAI_BASE_URL=http://115.244.46.68:8000/v1
LLM_MODEL=current-model
LLM_PROVIDER=qwen_gpu
QWEN_MODEL_NAME=current-model
OLLAMA_BASE_URL=http://localhost:11434

# ─── 7. RESOURCE GOVERNOR & HARDENING CONTROLS ────────────────────────────────
AGENT_LOOP_PACE_SECONDS=20
MAX_DISCOVERY_RESULTS_PER_CYCLE=10
MAX_CONCURRENT_CRAWLS=2
MAX_CONCURRENT_DEEP_CRAWLS=1
MAX_BROWSER_CONTEXTS=2
SAFE_BROWSER_PROCESS_LIMIT=4

# ─── 8. QUEUE WATERMARKS (HYSTERESIS) ─────────────────────────────────────────
DISCOVERY_QUEUE_HIGH_WATERMARK=100
DISCOVERY_QUEUE_LOW_WATERMARK=60
VERIFICATION_QUEUE_HIGH_WATERMARK=50
VERIFICATION_QUEUE_LOW_WATERMARK=25

# ─── 9. TIME-OUTS & CRAWL BUDGETS ─────────────────────────────────────────────
CRAWL_TIMEOUT_SECONDS=60
MAX_CRAWL_RETRIES=2
TASK_LEASE_TIMEOUT_SECONDS=300
STALE_TASK_TIMEOUT_SECONDS=300

# ─── 10. RESOURCE GOVERNOR THRESHOLDS ─────────────────────────────────────────
RESOURCE_PAUSE_MEMORY_PERCENT=85
RESOURCE_EMERGENCY_MEMORY_PERCENT=95
RESOURCE_PAUSE_CPU_PERCENT=90
RESOURCE_EMERGENCY_CPU_PERCENT=95
GOVERNOR_CACHE_TTL_SECONDS=5.0

# ─── 11. CRAWLER DOMAIN CAPS ──────────────────────────────────────────────────
MAX_PAGES_PER_DOMAIN_AGENT1=4
MAX_PAGES_PER_DOMAIN_AGENT2=10

# ─── 12. DATABASE POOL & CELERY PROCESS CONCURRENCY ───────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
MAX_TASKS_PER_WORKER=50
