# ==============================================================================
# OpenDb Environment Configuration
# ==============================================================================

# Application Environment Mode (Use 'production' for server with Docker, 'development' for local)
APP_ENV=production
OPENDB_ENV=production
LOG_LEVEL=INFO

# Database Credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=opendb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:password123@postgres:5432/opendb

# MinIO S3 Storage Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
STORAGE_BACKEND=minio

# Redis Cache & Celery Broker
REDIS_PASSWORD=opendb_redis_secret
REDIS_URL=redis://:opendb_redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:opendb_redis_secret@redis:6379/0
CELERY_RESULT_BACKEND=redis://:opendb_redis_secret@redis:6379/0

# SearXNG Meta-Search Engine
SEARXNG_URL=http://searxng:8080

# Qwen GPU & Remote LLM Inference Credentials
OPENAI_API_KEY=sk-datai2i-a100-qwen35-27b-8x3f9z
QWEN_API_KEY=sk-datai2i-a100-qwen35-27b-8x3f9z
OPENAI_BASE_URL=http://115.244.46.68:8000/v1
LLM_MODEL=current-model
LLM_PROVIDER=qwen_gpu
QWEN_MODEL_NAME=current-model
OLLAMA_BASE_URL=http://localhost:11434

# Crawling Limits
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=20
CRAWL_CONCURRENCY=5
